# Copia este archivo a .env y ajusta los valores.

PORT=3000

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# MySQL / MariaDB (XAMPP usa root sin contraseña por defecto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foco

# Orígenes permitidos separados por coma. Vacío = cualquiera (solo para desarrollo).
CORS_ORIGIN=
